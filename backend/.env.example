# ╔══════════════════════════════════════════════════════════════╗
# ║             Paper2Signal — Environment Configuration          ║
# ║  Copy this file to .env and fill in your values              ║
# ║  Never commit .env to git                                     ║
# ╚══════════════════════════════════════════════════════════════╝


# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=Paper2Signal
ENV=development                     # development | production
LOG_LEVEL=WARNING                   # DEBUG | INFO | WARNING | ERROR


# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default — works out of the box)
DATABASE_URL=sqlite+aiosqlite:///./papersignal.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/papersignal

# Vector Store
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=papers


# ── ArXiv Scraper ──────────────────────────────────────────────────────────────
# Categories to monitor — add/remove as needed
ARXIV_CATEGORIES=["cs.AI","cs.LG","cs.CL","cs.CV","stat.ML"]
ARXIV_MAX_RESULTS=100               # Papers fetched per scrape run
ARXIV_POLL_HOURS=6                  # How often to scrape (hours)
ARXIV_DAYS_BACK=7                   # Look back this many days on first run


# ── Embeddings ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2   # SentenceTransformer model name
EMBEDDING_BATCH_SIZE=32             # Papers per embedding batch


# ── Clustering (UMAP + HDBSCAN) ────────────────────────────────────────────────
HDBSCAN_MIN_CLUSTER_SIZE=3          # Minimum papers per cluster
HDBSCAN_MIN_SAMPLES=2               # HDBSCAN min_samples
UMAP_N_COMPONENTS=5                 # Reduced dimensions before clustering
UMAP_N_NEIGHBORS=10                 # UMAP neighborhood size


# ── Velocity Scoring ───────────────────────────────────────────────────────────
GITHUB_TOKEN=                       # Optional — increases GitHub API rate limit
VELOCITY_WINDOW_DAYS=7              # Window for star/citation delta
VELOCITY_STAR_WEIGHT=0.6            # Weight of GitHub stars in velocity score
VELOCITY_CITATION_WEIGHT=0.4        # Weight of Semantic Scholar citations


# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Agent 1 (Classifier) + Agent 3 (Scribe) + RAG
# Get free key at: https://console.groq.com
GROQ_API_KEY=

# Agent 2 (Scorer) — DeepSeek-R1 via HuggingFace Router
# Get free key at: https://huggingface.co/settings/tokens
HF_API_KEY=

# Fallback LLM — used when Groq and HF Router both fail
# Get key at: https://platform.openai.com
OPENAI_API_KEY=


# ── LLM Model Names ────────────────────────────────────────────────────────────
GROQ_FAST_MODEL=llama-3.3-70b-versatile
HF_REASONING_MODEL=deepseek-ai/DeepSeek-R1-Distill-Llama-8B:nscale
HF_HYPE_MODEL=shau1905/papersignal-hype-detector
OPENAI_FALLBACK_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
RAG_TOP_K=5


# ── PageIndex — Deep PDF Chat ──────────────────────────────────────────────────
# Required for "Go Deep" feature — full PDF reasoning
# Get key at: https://pageindex.ai
PAGEINDEX_API_KEY=


# ── API Server ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=False                    # Set True for development hot-reload


# ── Frontend (Vite) ────────────────────────────────────────────────────────────
# Add to frontend/.env
# VITE_API_URL=http://localhost:8000
